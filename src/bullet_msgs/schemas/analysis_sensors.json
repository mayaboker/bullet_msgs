{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "physics_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "episode_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "stream_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "step_index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "simulation_time_s": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000000000000.0
        },
        "measurement_us": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "physics_id",
        "episode_id",
        "stream_id",
        "step_index",
        "simulation_time_s",
        "measurement_us"
      ]
    },
    "sensors": {
      "type": "object",
      "properties": {
        "imu": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "episode_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096
                },
                "step_index": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "simulation_time_s": {
                  "type": "number",
                  "minimum": -1000000000000.0,
                  "maximum": 1000000000000.0
                },
                "specific_force_m_s2": {
                  "type": "array",
                  "items": {
                    "type": "number",
                    "minimum": -1000000000000.0,
                    "maximum": 1000000000000.0
                  },
                  "minItems": 3,
                  "maxItems": 3
                },
                "angular_velocity_rad_s": {
                  "type": "array",
                  "items": {
                    "type": "number",
                    "minimum": -1000000000000.0,
                    "maximum": 1000000000000.0
                  },
                  "minItems": 3,
                  "maxItems": 3
                }
              },
              "required": [
                "episode_id",
                "step_index",
                "simulation_time_s",
                "specific_force_m_s2",
                "angular_velocity_rad_s"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "barometer": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "episode_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096
                },
                "step_index": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "simulation_time_s": {
                  "type": "number",
                  "minimum": -1000000000000.0,
                  "maximum": 1000000000000.0
                },
                "pressure_pa": {
                  "type": "number",
                  "minimum": -1000000000000.0,
                  "maximum": 1000000000000.0,
                  "exclusiveMinimum": 0
                },
                "altitude_m": {
                  "type": "number",
                  "minimum": -1000000000000.0,
                  "maximum": 1000000000000.0
                }
              },
              "required": [
                "episode_id",
                "step_index",
                "simulation_time_s",
                "pressure_pa",
                "altitude_m"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "rangefinder": {
          "type": "null"
        }
      },
      "required": [
        "imu",
        "barometer",
        "rangefinder"
      ],
      "additionalProperties": false
    },
    "attitude_estimate": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "episode_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "step_index": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "simulation_time_s": {
              "type": "number",
              "minimum": -1000000000000.0,
              "maximum": 1000000000000.0
            },
            "orientation_xyzw": {
              "type": "array",
              "items": {
                "type": "number",
                "minimum": -1000000000000.0,
                "maximum": 1000000000000.0
              },
              "minItems": 4,
              "maxItems": 4
            }
          },
          "required": [
            "episode_id",
            "step_index",
            "simulation_time_s",
            "orientation_xyzw"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "publisher_drops": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "schema_version",
    "source",
    "sensors",
    "attitude_estimate",
    "publisher_drops"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
