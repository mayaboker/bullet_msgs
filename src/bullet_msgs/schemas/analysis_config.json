{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "physics_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "episode_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "stream_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "step_index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "simulation_time_s": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000000000000.0
        },
        "measurement_us": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "physics_id",
        "episode_id",
        "stream_id",
        "step_index",
        "simulation_time_s",
        "measurement_us"
      ]
    },
    "role": {
      "enum": [
        "physics",
        "app"
      ]
    },
    "settings": {
      "type": "object"
    },
    "revisions": {
      "type": "object",
      "additionalProperties": {
        "anyOf": [
          {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          {
            "type": "null"
          }
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "source",
    "role",
    "settings",
    "revisions"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
