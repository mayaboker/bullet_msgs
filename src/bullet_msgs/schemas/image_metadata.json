{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "image_topic": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "image_log_time_ns": {
      "type": "integer",
      "minimum": 0
    },
    "image_record_sequence": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "metadata": {
      "type": "object",
      "required": [
        "session",
        "sequence",
        "capture_ns"
      ],
      "properties": {
        "session": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "sequence": {
          "type": "integer",
          "minimum": 0
        },
        "capture_ns": {
          "type": "integer",
          "minimum": 0
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "physics_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,128}$"
            },
            "episode_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,128}$"
            },
            "stream_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,128}$"
            },
            "step_index": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "simulation_time_s": {
              "type": "number",
              "minimum": 0,
              "maximum": 1000000000000.0
            },
            "measurement_us": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "physics_id",
            "episode_id",
            "stream_id",
            "step_index",
            "simulation_time_s",
            "measurement_us"
          ]
        }
      }
    }
  },
  "required": [
    "schema_version",
    "image_topic",
    "image_log_time_ns",
    "image_record_sequence",
    "metadata"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
