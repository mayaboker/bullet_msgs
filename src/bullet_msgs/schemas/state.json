{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "type": "integer",
          "const": 1
        },
        "physics_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "controller_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,128}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "episode_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "state": {
          "enum": [
            "running",
            "stopped",
            "error"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "simulation_time_s": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000000000000.0
        }
      },
      "required": [
        "schema_version",
        "physics_id",
        "controller_id",
        "episode_id",
        "state",
        "reason",
        "simulation_time_s"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "type": "integer",
          "const": 2
        },
        "physics_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "controller_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,128}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "episode_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "state": {
          "enum": [
            "running",
            "stopped",
            "error"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "simulation_time_s": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000000000000.0
        },
        "terminal_result": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "schema_version": {
                  "type": "integer",
                  "const": 1
                },
                "event_id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_-]{1,128}$"
                },
                "collision": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "schema_version": {
                      "type": "integer",
                      "const": 1
                    },
                    "event_id": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9_-]{1,128}$"
                    },
                    "controller_id": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9_-]{1,128}$"
                    },
                    "issued_us": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "source": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "physics_id": {
                          "type": "string",
                          "pattern": "^[A-Za-z0-9_-]{1,128}$"
                        },
                        "episode_id": {
                          "type": "string",
                          "pattern": "^[A-Za-z0-9_-]{1,128}$"
                        },
                        "stream_id": {
                          "type": "string",
                          "pattern": "^[A-Za-z0-9_-]{1,128}$"
                        },
                        "step_index": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        },
                        "simulation_time_s": {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 1000000000000.0
                        },
                        "measurement_us": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        }
                      },
                      "required": [
                        "physics_id",
                        "episode_id",
                        "stream_id",
                        "step_index",
                        "simulation_time_s",
                        "measurement_us"
                      ]
                    },
                    "target_id": {
                      "const": "red_truck"
                    },
                    "drone_position_m": {
                      "type": "array",
                      "minItems": 3,
                      "maxItems": 3,
                      "items": {
                        "type": "number",
                        "minimum": -1000000000000.0,
                        "maximum": 1000000000000.0
                      }
                    }
                  },
                  "required": [
                    "schema_version",
                    "event_id",
                    "controller_id",
                    "issued_us",
                    "source",
                    "target_id",
                    "drone_position_m"
                  ]
                },
                "final_source": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "physics_id": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9_-]{1,128}$"
                    },
                    "episode_id": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9_-]{1,128}$"
                    },
                    "stream_id": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9_-]{1,128}$"
                    },
                    "step_index": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "simulation_time_s": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1000000000000.0
                    },
                    "measurement_us": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    }
                  },
                  "required": [
                    "physics_id",
                    "episode_id",
                    "stream_id",
                    "step_index",
                    "simulation_time_s",
                    "measurement_us"
                  ]
                },
                "outcome": {
                  "const": "success"
                },
                "reason": {
                  "const": "target_hit"
                },
                "ended_us": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "schema_version",
                "event_id",
                "collision",
                "final_source",
                "outcome",
                "reason",
                "ended_us"
              ]
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "schema_version",
        "physics_id",
        "controller_id",
        "episode_id",
        "state",
        "reason",
        "simulation_time_s",
        "terminal_result"
      ]
    }
  ]
}
