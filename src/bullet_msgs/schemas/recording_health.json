{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "complete": {
      "type": "boolean"
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "outcome": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "skipped_images": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "peak_queue_bytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "counts": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "accepted": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "written": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "accepted",
          "written"
        ],
        "additionalProperties": false
      }
    },
    "launch_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "episode": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "physics_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "episode_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          },
          "required": [
            "physics_id",
            "episode_id"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "complete",
    "reason",
    "outcome",
    "skipped_images",
    "peak_queue_bytes",
    "counts",
    "launch_id"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
