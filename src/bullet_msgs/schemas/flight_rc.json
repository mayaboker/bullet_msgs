{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "physics_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,128}$"
    },
    "episode_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,128}$"
    },
    "app_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,128}$"
    },
    "sequence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "issued_us": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "valid_until_us": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "active": {
      "type": "boolean"
    },
    "channels": {
      "type": "array",
      "minItems": 18,
      "maxItems": 18,
      "items": {
        "type": "integer",
        "minimum": 1000,
        "maximum": 2000
      }
    }
  },
  "required": [
    "schema_version",
    "physics_id",
    "episode_id",
    "app_id",
    "sequence",
    "issued_us",
    "valid_until_us",
    "active",
    "channels"
  ]
}
