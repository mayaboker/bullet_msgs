{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "type": "integer"
    },
    "physics_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,128}$"
    },
    "episode_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,128}$"
    },
    "controller_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,128}$"
    },
    "request_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,128}$"
    },
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "behavior": {
          "enum": [
            "constant",
            "gusts"
          ]
        },
        "velocity_world_m_s": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": -1000000000000.0,
            "maximum": 1000000000000.0
          },
          "minItems": 3,
          "maxItems": 3
        },
        "gust_stddev_m_s": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 1000000000000.0
          },
          "minItems": 3,
          "maxItems": 3
        },
        "correlation_time_s": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1000000000000.0
        },
        "seed": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "enabled",
        "behavior",
        "velocity_world_m_s",
        "gust_stddev_m_s",
        "correlation_time_s",
        "seed"
      ]
    },
    "issued_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "schema_version",
    "physics_id",
    "episode_id",
    "controller_id",
    "request_id",
    "settings",
    "issued_ms"
  ]
}
